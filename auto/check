#!/usr/bin/env bash
#
# The pre-merge gate: every test (including PostgreSQL), then the format check.
#
#   auto/check
#   auto/check --help
#
# PostgreSQL is managed by Testcontainers, so a Docker-compatible runtime must
# be available. Works unchanged as a CI step.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  sed -n '3,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

for arg in "$@"; do
  case "$arg" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'auto/check: unknown argument: %s\n\n' "$arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v sbt >/dev/null 2>&1; then
  printf 'auto/check: sbt is required but was not found on PATH.\n' >&2
  exit 1
fi

printf '==> running every suite, including PostgreSQL via Testcontainers\n'

# Two things about running this under sbt 2:
#   * `testFull` rather than `test` — Test/test depends on Test/testQuick, which
#     prints "Total 0" and exits 0 when it thinks nothing changed.
#   * Tasks are semicolon-separated; `sbt testFull scalafmtCheckAll` would be
#     parsed as a single command and fail.
sbt -batch -Dsbt.supershell=false "; testFull; scalafmtCheckAll"

printf '\n==> check passed — all suites, including PostgreSQL\n'
